#!/usr/bin/env bash
# Offline cheat sheets from the local cheat.sh upstream sources.
#
# usage: cheat [topic] [keyword]
#   topic    exact topic opens directly, otherwise it prefills the fzf query
#            lang/:learn         whole learnxinyminutes page    lang/Section  one section of it
#            lang/:list          every topic under lang/
#            rfc/NUMBER          an RFC
#            rosetta/TASK        a Rosetta Code task and the languages that solve it
#            lang/rosetta        every Rosetta Code task solved in lang
#            lang/rosetta/TASK   the lang solution(s) of TASK
#   keyword  only show the blocks that mention it (case-insensitive)
#
# RFCs and Rosetta Code are downloaded the first time they are opened, then kept.
# The fzf list holds lang/rosetta/TASK only for CHEAT_ROSETTA_LANGS (space separated);
# other languages still open when typed.
#
# Sources (override the root with CHEAT_SOURCES):
#   cheat.sheets/sheets  chubin/cheat.sheets  (lang sheets as lang/topic)
#   cheatsheets          cheat/cheatsheets
#   tldr-new/pages       tldr-pages (common, linux, then the other platforms)
#   learnxinyminutes     adambard/learnxinyminutes-docs  (as lang/:learn)
#                        git clone --depth 1 https://github.com/adambard/learnxinyminutes-docs \
#                            ~/.cache/remcli/sources/learnxinyminutes
#   rfc                  rfc-index.txt (titles) and every RFC opened so far
#   rosetta              index.txt (TASK/Lang/file of acmeism/RosettaCodeData) and every
#                        task opened so far
#   Both indexes refresh themselves in the background once a month.

SRC=${CHEAT_SOURCES:-$HOME/.cache/remcli/sources}
SHEETS=$SRC/cheat.sheets/sheets
CHEATS=$SRC/cheatsheets
TLDR=$SRC/tldr-new/pages
LEARN=$SRC/learnxinyminutes
RFC=$SRC/rfc
RFC_INDEX=$RFC/rfc-index.txt
RFC_URL=https://www.rfc-editor.org
ROSETTA=$SRC/rosetta
ROSETTA_INDEX=$ROSETTA/index.txt
ROSETTA_REPO=https://github.com/acmeism/RosettaCodeData
ROSETTA_RAW=https://raw.githubusercontent.com/acmeism/RosettaCodeData/main/Task
read -ra ROSETTA_LANGS <<< "${CHEAT_ROSETTA_LANGS:-python javascript typescript go rust c c++ unix-shell lua}"
PLATFORMS=(common linux osx windows android freebsd openbsd netbsd sunos dos cisco-ios)
# cheat.sh language names -> learnxinyminutes page
declare -A LEARN_ALIAS=(
    [cpp]=c++ [js]=javascript [python3]=python [perl6]=raku [coffee]=coffeescript
    [lisp]=common-lisp [mathematica]=wolfram [octave]=matlab [vb]=visualbasic
)
# common language names -> Rosetta Code language (lowercased)
declare -A ROSETTA_ALIAS=(
    [cpp]=c++ [js]=javascript [ts]=typescript [bash]=unix-shell [sh]=unix-shell
    [csharp]=c-sharp [fsharp]=f-sharp [python3]=python [perl6]=raku
)
BAT=$(command -v batcat || command -v bat)

topics() {
    {
        find "$SHEETS" -type f ! -name '.*' ! -name '_info.yaml' -printf '%P\n' | sed 's|^_||'
        find "$CHEATS" -mindepth 1 -name '.*' -prune -o -type f -printf '%P\n'
        for p in "${PLATFORMS[@]}"; do
            find "$TLDR/$p" -name '*.md' -printf '%f\n'
        done | sed 's/\.md$//'
        learn_topics
        rfc_topics
        rosetta_topics
    } 2>/dev/null | awk -F/ '
        !seen[$0]++ { print }
        NF > 1 { lang[$1] }
        END { for (l in lang) print l "/:list" }
    ' # unsorted so fzf can start before every source is read
}

# fetch URL FILE: download FILE once; a failed download leaves nothing behind
fetch() {
    local tmp
    [ -s "$2" ] && return
    mkdir -p "${2%/*}" && tmp=$(mktemp "$2.XXXXXX") || return 1
    if curl -fsL --max-time 60 -o "$tmp" "$1"; then
        mv "$tmp" "$2"
    else
        rm -f "$tmp"
        return 1
    fi
}

# refresh FILE COMMAND...: when FILE is missing or a month old, replace it in the
# background with the output of COMMAND
refresh() {
    local file=$1
    shift
    [ -f "$file" ] && [ -z "$(find "$file" -mtime +30)" ] && return
    [ -f "$file" ] && touch "$file" # one refresh a month, even when it fails
    (
        mkdir -p "${file%/*}" && tmp=$(mktemp "$file.XXXXXX") || exit
        if "$@" > "$tmp" && [ -s "$tmp" ]; then mv "$tmp" "$file"; else rm -f "$tmp"; fi
    ) >/dev/null 2>&1 &
    disown
}

# --- learnxinyminutes ---

learn_file() {
    local lang=${1%%/*}
    echo "$LEARN/${LEARN_ALIAS[$lang]:-$lang}.md"
}

# A learnxinyminutes section is a title line framed by two banner lines made of
# one repeated symbol, e.g. "####...", "## 1. Functions", "####...".
# Without want=SECTION, list every "page/Section" (and "alias/Section");
# with it, print that section of the single given page as a fenced code block.
# shellcheck disable=SC2016
SECTIONS_AWK='
function banner(l,  k) {
    if (l !~ /^[[:space:]]*[^[:alnum:][:space:]]+[[:space:]]*$/) return 0
    gsub(/[[:space:]]/, "", l)
    if (length(l) < 6) return 0
    for (k = 2; k <= length(l); k++) if (substr(l, k, 1) != substr(l, 1, 1)) return 0
    return 1
}
function title(l) {
    gsub(/^[^[:alnum:]]+|[^[:alnum:]+]+$/, "", l); sub(/^[0-9.]+[[:space:]]*/, "", l)
    gsub(/[^[:alnum:][:space:]_+,-]/, "", l); gsub(/[[:space:]]/, "_", l); return l
}
# the two lines before a section header are its own, so output lags two lines
function flush() { if (k >= 2) print p2; if (k >= 1) print p1; print "```"; on = 0 }
BEGIN { n = split(aliases, al, " "); for (i = 1; i <= n; i++) { split(al[i], kv, "="); alias[kv[2]] = alias[kv[2]] " " kv[1] } }
FNR == 1 { page = FILENAME; sub(/.*\//, "", page); sub(/\.md$/, "", page); p1 = p2 = ""; lang = "" }
on && /^```$/ { flush(); exit }
/^```[^`]/ { lang = substr($0, 4) }
{
    t = ""
    if (p2 != "" && banner($0) && banner(p2) && !banner(p1)) t = title(p1)
    if (t != "" && want == "") {
        print page "/" t
        n = split(alias[page], names, " "); for (i = 1; i <= n; i++) print names[i] "/" t
    } else if (t != "" && on) {
        print "```"; on = 0; exit
    } else if (t != "" && t == want) {
        on = 1; k = 0; print "```" lang; print p2; print p1; print
    } else if (on && ++k >= 3) {
        print p2
    }
    p2 = p1; p1 = $0
}
END { if (on) flush() }'

learn_aliases() {
    local a
    for a in "${!LEARN_ALIAS[@]}"; do printf '%s=%s ' "$a" "${LEARN_ALIAS[$a]}"; done
}

learn_topics() {
    local f lang
    for f in "$LEARN"/*.md; do
        lang=${f##*/} lang=${lang%.md}
        [ "$lang" = README ] || echo "$lang/:learn"
    done
    for lang in "${!LEARN_ALIAS[@]}"; do
        [ -f "$(learn_file "$lang")" ] && echo "$lang/:learn"
    done
    LC_ALL=C awk -v aliases="$(learn_aliases)" "$SECTIONS_AWK" "$LEARN"/*.md
}

# learn_section LANG/SECTION: print it, fail when there is no such section
learn_section() {
    local f out
    f=$(learn_file "$1")
    [ -f "$f" ] || return 1
    out=$(LC_ALL=C awk -v want="${1#*/}" "$SECTIONS_AWK" "$f")
    [ -n "$out" ] && echo "$out"
}

# --- RFCs ---

# "rfc/NUMBER<TAB>Title" for every issued RFC in the index; the title is only
# shown and searched in fzf, the topic is the first field
rfc_topics() {
    [ -f "$RFC_INDEX" ] || return
    LC_ALL=C awk '
        function out(  n, t) {
            n = e; sub(/ .*/, "", n); t = substr(e, length(n) + 2)
            if (t !~ /^Not Issued/) { sub(/\. .*/, "", t); printf "rfc/%d\t%s\n", n, t }
            e = ""
        }
        /^[0-9]+ / { if (e != "") out(); e = $0; next }
        /^ +/ && e != "" { sub(/^ +/, " "); e = e $0; next }
        e != "" { out() }
        END { if (e != "") out() }
    ' "$RFC_INDEX"
}

# rfc_sheet NUMBER: print the RFC, downloading it once.
# With NO_FETCH set (fzf preview) it only shows the index entry of a missing one.
rfc_sheet() {
    local n=$((10#$1)) f
    f=$RFC/rfc$n.txt
    if [ ! -s "$f" ]; then
        if [ -n "$NO_FETCH" ]; then
            awk -v n="$n" 'BEGIN { RS = "" } $1 == n' "$RFC_INDEX" 2>/dev/null
            printf '\n(not downloaded yet: open it to download and keep it)\n'
            return
        fi
        echo "Downloading RFC $n..." >&2
        fetch "$RFC_URL/rfc/rfc$n.txt" "$f" || { echo "cheat: could not download RFC $n" >&2; return 1; }
    fi
    tr -d '\f' < "$f" | sed '/./,$!d'
}

rfc_index_download() {
    curl -fsL --max-time 60 "$RFC_URL/rfc-index.txt"
}

# --- Rosetta Code ---

rosetta_topics() {
    [ -f "$ROSETTA_INDEX" ] || return
    LC_ALL=C awk -F/ -v langs=" ${ROSETTA_LANGS[*]} " '
        BEGIN { langs = tolower(langs) }
        { l = tolower($2) }
        !($1 in task) { task[$1]; print "rosetta/" $1 }
        !(l in lang) { lang[l]; print l "/rosetta" }
        index(langs, " " l " ") && !((l, $1) in seen) { seen[l, $1]; print l "/rosetta/" $1 }
    ' "$ROSETTA_INDEX"
}

rosetta_lang() {
    local l=${1,,}
    echo "${ROSETTA_ALIAS[$l]:-$l}"
}

# rosetta_files TASK [LANG]: index lines (Task/Lang/file) of TASK, case-insensitive
rosetta_files() {
    LC_ALL=C awk -F/ -v t="$1" -v l="$2" '
        tolower($1) == tolower(t) && (l == "" || tolower($2) == l)
    ' "$ROSETTA_INDEX" 2>/dev/null
}

# MediaWiki markup of the task descriptions -> plain text
wiki_to_text() {
    sed -E \
        -e 's/\{\{[^}]*\}\}//g' \
        -e 's/\[\[(wp:)?[^]|]*\|([^]]*)\]\]/\2/g' -e 's/\[\[(wp:)?([^]]*)\]\]/\2/g' \
        -e "s/'{2,}//g" -e 's/<[^>]+>//g' -e 's/&nbsp;/ /g' \
        -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g' \
        -e 's/^;(.*)/\n\1/' -e 's/^:*\*+ */  - /' -e 's/^:+//' -e 's/[[:space:]]+$//' |
        cat -s | sed '/./,$!d'
}

rosetta_sheet() {
    local t=$1 lang task files f path n sep
    case $t in
    rosetta/*)
        files=$(rosetta_files "${t#rosetta/}" | cut -d/ -f1,2 | uniq)
        [ -n "$files" ] || return 1
        task=${files%%/*}
        f=$ROSETTA/Task/$task/00-TASK.txt
        if [ ! -s "$f" ] && [ -z "$NO_FETCH" ]; then
            echo "Downloading $task..." >&2
            fetch "$ROSETTA_RAW/$task/00-TASK.txt" "$f"
        fi
        if [ -s "$f" ]; then
            wiki_to_text < "$f"
        else
            echo "(description not downloaded yet: open it to download and keep it)"
        fi
        printf '\nSolved in %s languages, open one as LANG/rosetta/%s:\n' "$(wc -l <<< "$files")" "$task"
        cut -d/ -f2 <<< "$files" | tr '[:upper:]' '[:lower:]' | paste -sd ' ' | fold -sw 80
        ;;
    */rosetta)
        lang=$(rosetta_lang "${t%/rosetta}")
        LC_ALL=C awk -F/ -v l="$lang" 'tolower($2) == l && !seen[$1]++ { print l "/rosetta/" $1 }' \
            "$ROSETTA_INDEX" 2>/dev/null | grep .
        ;;
    */rosetta/*)
        lang=$(rosetta_lang "${t%%/rosetta/*}")
        files=$(rosetta_files "${t#*/rosetta/}" "$lang")
        [ -n "$files" ] || return 1
        n=$(wc -l <<< "$files")
        sep=
        while read -r path; do
            f=$ROSETTA/Task/$path
            if [ ! -s "$f" ]; then
                if [ -n "$NO_FETCH" ]; then
                    printf '%s\n(not downloaded yet: open it to download and keep it)\n' "${path##*/}"
                    continue
                fi
                echo "Downloading ${path##*/}..." >&2
                fetch "$ROSETTA_RAW/$path" "$f" || { echo "cheat: could not download $path" >&2; return 1; }
            fi
            [ "$n" -gt 1 ] && printf '%b──── %s ────\n' "$sep" "${path##*/}" && sep='\n'
            cat "$f"
        done <<< "$files"
        ;;
    esac
}

rosetta_index_download() {
    local d rc
    d=$(mktemp -d) || return 1
    git clone -q --filter=blob:none --no-checkout --depth 1 "$ROSETTA_REPO" "$d/repo" &&
        git -C "$d/repo" ls-tree -r --name-only HEAD Task/ | sed 's|^Task/||' | grep -v '/00-'
    rc=$?
    rm -rf "$d"
    return $rc
}

# --- local sheets ---

# tldr markdown -> "# description" / "command" blocks, like cheat.sh renders it
tldr_to_sheet() {
    awk '
        /^# /      { print; next }
        /^> /      { sub(/^> /, "# "); print; next }
        /^- /      { sub(/^- /, "# "); print ""; print; next }
        /^`.*`$/   { s = substr($0, 2, length($0) - 2); gsub(/\{\{|\}\}/, "", s); print s }
    ' "$1"
}

strip_frontmatter() {
    awk 'NR == 1 && /^---$/ { fm = 1; next } fm && /^---$/ { fm = 0; next } !fm' "$1"
}

sheet() {
    local t=$1 f p found=
    case $t in
    */:list)
        topics | cut -f1 | grep "^${t%/:list}/" | grep -v '/:list$' | LC_ALL=C sort
        return
        ;;
    rfc/*)
        [[ $t =~ ^rfc/([0-9]+)$ ]] && rfc_sheet "${BASH_REMATCH[1]}"
        return
        ;;
    rosetta/* | */rosetta | */rosetta/*)
        rosetta_sheet "$t"
        return
        ;;
    */:learn)
        f=$(learn_file "$t")
        [ -f "$f" ] && strip_frontmatter "$f"
        return
        ;;
    esac
    f=$SHEETS/$t
    [[ $t == */* ]] && f=$SHEETS/_$t
    [ -f "$f" ] && { cat "$f"; echo; found=1; }
    [ -f "$CHEATS/$t" ] && { strip_frontmatter "$CHEATS/$t"; echo; found=1; }
    for p in "${PLATFORMS[@]}"; do
        [ -f "$TLDR/$p/$t.md" ] && { tldr_to_sheet "$TLDR/$p/$t.md"; found=1; break; }
    done
    [ -z "$found" ] && [[ $t == */* ]] && learn_section "$t" && found=1
    [ -n "$found" ]
}

filter() {
    if [ -z "$1" ]; then cat; return; fi
    awk -v k="$1" 'BEGIN { RS = ""; ORS = "\n\n"; k = tolower(k) } index(tolower($0), k)'
}

# highlight TOPIC [bat options]: shell-like by default, learnxinyminutes as markdown,
# Rosetta Code solutions by their file extension, lists and RFCs as plain text
highlight() {
    local t=$1 syntax=(-l bash) f
    shift
    case $t in
    */:list | rfc/* | rosetta/* | */rosetta) syntax=(-l txt) ;;
    */rosetta/*)
        f=$(rosetta_files "${t#*/rosetta/}" "$(rosetta_lang "${t%%/rosetta/*}")" | head -1)
        syntax=(--file-name "${f##*/}")
        ;;
    */:learn) syntax=(-l md) ;;
    */*)
        [ ! -f "$SHEETS/_$t" ] && [ ! -f "$CHEATS/$t" ] && [ -f "$(learn_file "$t")" ] && syntax=(-l md)
        ;;
    esac
    if [ -n "$BAT" ]; then "$BAT" "${syntax[@]}" --style=plain "$@"; else cat; fi
}

[ -d "$SRC" ] || { echo "cheat: sources not found in $SRC" >&2; exit 1; }

if [ "$1" = --preview ]; then
    NO_FETCH=1 sheet "$2" | highlight "$2" --color=always
    exit
fi

refresh "$RFC_INDEX" rfc_index_download
command -v git >/dev/null && refresh "$ROSETTA_INDEX" rosetta_index_download

topic=$1 keyword=$2
# an existing topic opens directly; anything else goes through fzf
if [ -z "$topic" ] || ! raw=$(sheet "$topic") || [ -z "${raw//[[:space:]]/}" ]; then
    topic=$(topics | fzf --border --prompt="Select a cheat sheet: " -q "$topic" --delimiter='\t' \
        --preview "$(printf '%q' "$0") --preview {1}" --preview-window=right,60% | cut -f1)
    [ -z "$topic" ] && exit 0
    raw=$(sheet "$topic")
fi

out=$(filter "$keyword" <<< "$raw")
if [ -z "${out//[[:space:]]/}" ]; then
    echo "No cheat sheet found for \"$topic\"${keyword:+ matching \"$keyword\"}" >&2
    exit 1
fi
if [ -t 1 ]; then highlight "$topic" --paging=auto <<< "$out"; else echo "$out"; fi

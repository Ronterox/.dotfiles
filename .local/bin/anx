#!/usr/bin/env bash

todo() { rg --hidden --max-depth 5 TODO: "$1"; }

if [ $# -eq 0 ]; then
    clear && figlet "ANX" | lolcat
    jrnl @should @annoying @will @need -not @done && todo ~/Documents/Projects/ && project schedule && doing recent
    exit 0
fi

case "$1" in
	-h|--help)
		info=(
			"todo: Shows all the TODOs in the current directory"
			"plan: Shows the plan for the current day"
			"schedule: Generates a schedule for the current day"
			"today: Shows all the doings for today"
			"yesterday: Shows all the doings for yesterday"
			"sat|mon|tue|thu|fri|sun|wed: Shows all the doings for the day"
			"now|later: Adds a doing for now or later"
			"done|did: completes the last doing, or the pattern passed"
			"edit: Opens to edit the doing file"
			"recent: Shows all the recent doings oldest to newest"
			"sort: Shows all the doings sorted by tag"
			"last: Shows the last not done doing"
			"count: Counts the number of doings per tag"
			"archive: Archives the doings"
			"note: pass the topic and call jrnl tooling for annotations"
			"notes: Calls jrnl tooling with a limit of 10 notes"
			""
		)
		echo -e "\nUsage: anx <todo|plan|schedule|day|now|done|recent|archive> [args]"
		for i in "${info[@]}"; do
			echo -en "\t"
			echo "$i"
		done
		exit 0
		;;
    today|yesterday|sat|mon|tue|thu|fri|sun|wed|now|next|done|did|sort|later|recent|undo|archive|edit|last)
        doing "$@"
        ;;
	count)
		tags=$(anx sort | cut -d':' -f2 | cut -d'>' -f2 | awk '{print $1}' | sort -u)
		for t in $tags; do
			[ "$t" = "║" ] && continue
			printf "%s: %s\n" ${t^} "$(anx recent | rg ${t^} | wc -l)"
		done | sort --field-separator=: --key=2nr
		;;
    todo)
		todo "${2:-.}"
        ;;
	plan)
		project schedule
		;;
	schedule)
		start_time="$2"
		shift 2

		IFS=':' read -r h m <<< "$start_time"
		current_minutes=$((10#$h * 60 + 10#$m))

		IFS='>'
		indent=""
		output=""
		for task in $@; do
			printf -v out "%02d:%02d %s\n" $((current_minutes/60)) $((current_minutes%60)) "$task"
			output+="$out"

			printf -v out '%s\->' "$indent"
			output+="$out"

			indent+=" "
			current_minutes=$((current_minutes + 50))
		done
		printf -v out '%02d:%02d Done\n' $((current_minutes/60)) $((current_minutes%60))
		output+="$out"

		echo "$output" | lolcat -F 0.08 -p 1 -S 120 -a
		;;
    note)
		topic="${2^^}"
		shift 2
        jrnl "Annotation related to $topic." "$@"
        ;;
    notes)
		shift
		if [ -z "$*" ]; then
			jrnl -n 10
		else
			jrnl -contains "$*"
		fi
		;;
	*)
		pattern="$*"
		[[ "$pattern" =~ ^: ]] && pattern="${pattern:1}"
		rg -S "$pattern" ~/Documents/Projects/MarkdownProjects/ANX/
		;;
esac

#!/usr/bin/env bash

set -e

if hash bun 2>/dev/null; then
	bunx @mermaid-js/mermaid-cli "$@"
	exit 0
fi

echo "Recommended to install bun for: bunx @mermaid-js/mermaid-cli --input '-' --output 'out.svg'"

if test -f "$1"; then
  data=$(cat "$1")
else
  data=$1
fi

link=https://mermaid.ink/img/"$(echo "$data" | base64 -w 0)";
echo Downloading $link...;

wget "$link" -O "$PWD/mermaid.png"


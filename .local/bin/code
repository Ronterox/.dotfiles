#!/usr/bin/env bash

if [ $# -eq 0 ]; then
	echo "Usage: code <git?> <pattern>"
	exit 0
fi

g() {
	if [ $# -eq 0 ]; then
		git status
		return
	fi
	selection=$(git log -G "$*" -p | rg "$*" | fzf | sed 's/^[+-]//; s/^ *//')
	[ "$selection" ] && nvim <(git log -S "$selection" -p)
}

if [ "$1" = 'git' ]; then
	shift && g "$@"
	exit 0
fi

opts="-S"
if [ "$1" = 'vim' ]; then
	shift
	opts="$opts --vimgrep"
fi

langs=(asm c cpp py php ts rust ruby java js)
# declare -A langs=([c]='//' [sh]='#' [py]='#' [rb]='=begin' [java]='//' [js]='//')
for lang in "${langs[@]}"; do
	rg "$*" $opts -t "$lang" "$HOME" 2>/dev/null
done


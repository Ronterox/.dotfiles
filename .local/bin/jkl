#!/usr/bin/env bash

HOSTURL="http://richserver:6040/"
# url="http://localhost:6040/"

REPO="https://raw.githubusercontent.com/Ronterox/.dotfiles/refs/heads/linux/.local/bin/jkl"
METHODS=(get upload delete fzf ssh ip location update send 0x0 0x0text shorta weather mapscii uptime joke nyan games yt-url)

case "$1" in
    --help|-h)
        echo -e "Usage: $0 [method] [filepath/query] [name]\n"
        echo "Available methods:"
        for method in "${METHODS[@]}"; do
            echo "  $method"
        done
        echo -e "Examples:\n  $0 /path/to/file \n  $0 :delete /path/to/file\n  $0 :upload /path/to/file\n  $0 :upload /path/to/file newname.txt\n"
        ;;
    :get)
        $0 "$2"
        ;;
    :upload)
        if [ -z "$2" ]; then
            echo "Cannot upload without a filepath!"
            exit 1
        fi
        curl -# -F "file=@$2" "$HOSTURL${3:-$2}"
        ;;
    :delete)
        if [ -z "$2" ]; then
            echo "Cannot delete without a filepath!"
            exit 1
        fi
        curl -X DELETE -# "$HOSTURL$2"
        ;;
    :fzf)
        result=$(curl "$HOSTURL$2" | fzf --border)
        if [ -z "$result" ]; then
            exit 1
        fi
        $0 "$result"
        ;;
    :ssh)
        echo "Connecting to server..."
        ssh rontero@richserver
        ;;
    :ip)
        xh -b ifconfig.me user-agent:curl/7.64.1
        ;;
    :location)
        xh -b api.ip2location.io
        ;;
    :update)
        curl "$REPO" > "$0"
        ;;
    :send)
        shift
        if [ -z "$1" ]; then
            croc
        else
            croc send "$@"
        fi
        ;;
    :0x0)
        if [ -z "$2" ]; then
            echo "Cannot upload without a filepath!"
            exit 1
        fi
        xhs -b 0x0.st -f "file@$2"
        ;;
    :0x0text)
        if [ -z "$2" ]; then
            echo "Won't upload empty text!"
            exit 1
        fi
        shift
        xhs -b --ignore-stdin 0x0.st -f file@- <<< "$@"
        ;;
    :shorta)
        if [ -z "$2" ]; then
            echo "No URL provided!"
            exit 1
        fi
        xhs -b shorta.link -f url="$2"
        ;;
    :weather)
        xhs -b wttr.in/${2:-}
        ;;
    :mapscii)
        xhs -b mapscii.me
        ;;
    :uptime)
        email=$2
        HOSTURL=$3
        if [ -z "$email" ]; then
            echo "No email provided!"
            exit 1
        fi
        if [ -z "$HOSTURL" ]; then
            echo "No URL provided!"
            exit 1
        fi
        xhs "ping.gl/$email/$HOSTURL"
        ;;
    :joke)
        xhs -b icanhazdadjoke.com user-agent:curl/7.64.1
        ;;
    :nyan)
        curl ascii.live/nyan
        ;;
    :games)
        games=(
            "ssh sshtron.zachlatta.com"
            "ssh netris.rocketnine.space"
            "sshpass -p 'play' ssh -o StrictHostKeyChecking=no -p 2222 play@anonymine-demo.oskog97.com"
            "ssh gameroom@bitreich.org"
            "sshpass -p intricacy intricacy@sshgames.thegonz.net"
            "sshpass -p lag slashem@slashem.me"
            "ssh slashem@slashem.me"
            "ssh -p 8080 -l magnetic magneticscrolls.net" # 259CN
            "nc aardmud.org 23" # Ricamont
            "nc freechess.org 23"
            "telnet dungeon.name 20028"
            "telnet multizork.icculus.org"
        )
        selected=$(printf "%s\n" "${games[@]}" | fzf --preview="eval '{}'" --cycle --layout=reverse)
        if [ -z "$selected" ]; then
            exit 1
        fi
        eval "$selected"
        ;;
    :yt-url)
        HOSTURL=$2
        if [ -z "$HOSTURL" ]; then
            echo "No URL provided!"
            exit 1
        fi
        xhs -b "$HOSTURL" user-agent:curl/7.64.1 | pup 'link[href*="/channel/"] attr{href}'
        ;;
    :*)
        echo "Invalid method!"
        echo "Try 'jkl --help' for more information"
        exit 1
        ;;
    *)
        curl -# "$HOSTURL$1"
        ;;
esac

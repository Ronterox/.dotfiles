#!/usr/bin/env bash

HOSTURL="http://richserver:6040/"
# url="http://localhost:6040/"

ME="jkl"
REPO="shorta.link/stSYx29a"
METHODS=(get upload delete fzf ssh ip location update send 0x0 0x0text shorta weather mapscii uptime joke games yt-url)

case "$1" in
    --help|-h)
        echo -e "Usage: $ME [method] [filepath/query] [name]\n"
        echo "Available methods:"
        for method in "${METHODS[@]}"; do
            echo "  $method"
        done
        echo -e "Examples:\n  $ME /path/to/file \n  $ME :delete /path/to/file\n  $ME :upload /path/to/file\n  $ME :upload /path/to/file newname.txt\n"
        ;;
    :get)
        $ME "$2"
        ;;
    :upload)
        if [ -z "$2" ]; then
            echo "Cannot upload without a filepath!"
            exit 1
        fi
        curl -# -F "file=@$2" "$HOSTURL${3:-$2}"
        ;;
    :delete)
        if [ -z "$2" ]; then
            echo "Cannot delete without a filepath!"
            exit 1
        fi
        curl -X DELETE -# "$HOSTURL$2"
        ;;
    :fzf)
        result=$(curl "$HOSTURL$2" | fzf --border)
        if [ -z "$result" ]; then
            exit 1
        fi
        $ME "$result"
        ;;
    :ssh)
        echo "Connecting to server..."
        ssh rontero@richserver
        ;;
    :ip)
        xh -b ifconfig.me user-agent:curl/7.64.1
        ;;
    :location)
        xh -b api.ip2location.io
        ;;
    :update)
        xhs -F -b "$REPO" > "$ME"
        ;;
    :send)
        shift
        if [ -z "$1" ]; then
            croc
        else
            croc send "$@"
        fi
        ;;
    :0x0)
        if [ -z "$2" ]; then
            echo "Cannot upload without a filepath!"
            exit 1
        fi
        xhs -b 0x0.st -f "file@$2"
        ;;
    :0x0text)
        if [ -z "$2" ]; then
            echo "Won't upload empty text!"
            exit 1
        fi
        shift
        xhs -b --ignore-stdin 0x0.st -f file@- <<< "$@"
        ;;
    :shorta)
        if [ -z "$2" ]; then
            echo "No URL provided!"
            exit 1
        fi
        xhs -b shorta.link -f url="$2"
        ;;
    :weather)
        xhs -b wttr.in/${2:-}
        ;;
    :mapscii)
        telnet mapscii.me
        ;;
    :uptime)
        email=$2
        HOSTURL=$3
        if [ -z "$email" ]; then
            echo "No email provided!"
            exit 1
        fi
        if [ -z "$HOSTURL" ]; then
            echo "No URL provided!"
            exit 1
        fi
        xhs "ping.gl/$email/$HOSTURL"
        ;;
    :joke)
        xhs -b icanhazdadjoke.com user-agent:curl/7.64.1
        ;;
    :games)
        games=(
            "ssh sshtron.zachlatta.com"
            "ssh netris.rocketnine.space"
            "sshpass -p 'play' ssh -o StrictHostKeyChecking=no -p 2222 play@anonymine-demo.oskog97.com"
            "ssh gameroom@bitreich.org"
            "sshpass -p intricacy intricacy@sshgames.thegonz.net"
            "sshpass -p lag slashem@slashem.me"
            "ssh slashem@slashem.me"
            "ssh -p 8080 -l magnetic magneticscrolls.net" # 259CN
            "nc aardmud.org 23" # Ricamont
            "nc freechess.org 23"
            "telnet dungeon.name 20028"
            "telnet multizork.icculus.org"
        )
        selected=$(printf "%s\n" "${games[@]}" | fzf --preview="eval '{}'" --cycle --layout=reverse)
        if [ -z "$selected" ]; then
            exit 1
        fi
        eval "$selected"
        ;;
    :yt-url)
        HOSTURL=$2
        if [ -z "$HOSTURL" ]; then
            echo "No URL provided!"
            exit 1
        fi
        xhs -b "$HOSTURL" user-agent:curl/7.64.1 | pup 'link[href*="/channel/"] attr{href}'
        ;;
    :upload-config)
        if [ -z "$2" ]; then
            echo "No filepath provided!"
            exit 1
        fi
        baseurl="https://api.jsonbin.io/v3"
        name=$(basename "$2")
        yq -o=json "$2" | xh "$baseurl/b" X-Master-key:"$(pass show api/jsonbin)" X-Bin-Name:"$name" | yq .metadata
        ;;
    :get-config)
        if [ -z "$2" ]; then
            echo "No filepath provided!"
            exit 1
        fi
        baseurl="https://api.jsonbin.io/v3"
        xh "$baseurl/b/$2" X-Master-key:"$(pass show api/jsonbin)" | yq .record -o=yaml -P
        ;;
    :httpbin)
        baseurl="http(s)://httpbin.org"
        echo "Download $baseurl/image/[format] E.g png,jpeg,etc"
        echo "Test methods: $baseurl/[method] E.g get,post,etc"
        echo "Get Status code: $baseurl/status/[code] E.g 200,404,etc, supports any method"
        echo "Get Headers: $baseurl/headers"
        echo "Get IP: $baseurl/ip"
        echo "Get User Agent: $baseurl/user-agent"
        echo "Return format: $baseurl/[format] E.g json,xml,gzip,etc"
        echo "Delay request: $baseurl/delay/[seconds], supports any method"
        echo "Streaming: $baseurl/stream/[n], n is the number of chunks to stream"
        echo "stream=json,stream-bytes=bytes"
        ;;
    :compile)
        baseurl="https://wandbox.org/api"
        compiler=$(xh -F "$baseurl/list.json" | jq -c '.[] | {language,name}' | fzf --layout=reverse) && [ -z "$compiler" ] && exit 1
        language=$(echo "$compiler" | jq -r .language) && name=$(echo "$compiler" | jq -r .name)
        if [ -z "$2" ]; then
            tmp=$(mktemp)
            nvim "$tmp" -c "set filetype=${language,,}"
            code=$(cat "$tmp")
            if [ -z "$code" ]; then
                echo "No code provided!"
                exit 1
            fi
        else
            code=$(cat "$2")
        fi
        echo "Compiling..."
        echo "$code"
        xh --json "$baseurl/compile.json" compiler="$name" code="$code" | yq -P
        ;;
    :waifu)
        declare -A categories=(
            [sfw]="waifu neko shinobu megumin bully cuddle cry hug awoo kiss lick pat smug bonk yeet blush smile wave highfive handhold nom bite glomp slap kill kick happy wink poke dance cringe"
            [nsfw]="waifu neko trap blowjob"
        )

        echo "Selecting category..."
        category=$(printf "%s\n" "${!categories[@]}" | fzf --layout=reverse)
        [ -z "$category" ] && exit 1

        # Split the space-separated tags into an array
        IFS=' ' read -r -a tags <<< "${categories[$category]}"

        # Select image/tag
        echo "Selecting image..."
        image=$(printf "%s\n" "${tags[@]}" | fzf --layout=reverse)
        [ -z "$image" ] && exit 1

        while true; do
            tmp=$(mktemp)
            url=$(xhs -b "https://api.waifu.pics/$category/$image" | jq -r .url)
            xh -b "$url" -d -o="$tmp" && timg "$tmp" && rip "$tmp"
            echo "url: $url" && read -r -p "Press enter to continue, or ctrl+c to exit: "
        done
        ;;
    :waifu2)
        declare -A categories=(
            [sfw]="waifu maid oppai selfies uniform"
            [nsfw]="ero ass hentai milf oral paizuri ecchi"
        )

        echo "Selecting category..."
        category=$(printf "%s\n" "${!categories[@]}" | fzf --layout=reverse)
        [ -z "$category" ] && exit 1

        # Split the space-separated tags into an array
        IFS=' ' read -r -a tags <<< "${categories[$category]}"

        # Select image/tag
        echo "Selecting image..."
        image=$(printf "%s\n" "${tags[@]}" | fzf --layout=reverse)
        [ -z "$image" ] && exit 1

        while true; do
            tmp=$(mktemp)
            url=$(xh 'https://api.waifu.im/search' "included_tags==$image" | jq -r '.images | .[0].url')
            xh -b "$url" -d -o="$tmp" && timg "$tmp" && rip "$tmp"
            echo "url: $url" && read -r -p "Press enter to continue, or ctrl+c to exit: "
        done
        ;;
    :xencrypt)
        if [ -t 0 ] && [ -z "$2" ]; then
            echo "No text/filepath provided!"
            exit 1
        fi
		cache=$(mktemp)
		echo "#!/usr/bin/env -S $ME :run"
		cat <<- END | brotli | base64 -w 0
			#!/usr/bin/env bash
			[ -x $cache ] && $cache "\$@" && exit \$?
			echo $(cat $2 | "$ME" :encrypt) | $ME :decrypt > $cache
			chmod +x $cache && $cache "\$@"
		END
        ;;
    :encrypt)
        if [ -t 0 ] && [ -z "$2" ]; then
            echo "No text/filepath provided!"
            exit 1
        fi
		cat $2 | brotli | openssl enc -aes-256-cbc -salt -pbkdf2 -pass "pass:$(pass show phrase/openssl)" | base64 -w 0
        ;;
    :decrypt)
        if [ -t 0 ] && [ -z "$2" ]; then
            echo "No text/filepath provided!"
            exit 1
        fi
        cat $2 | base64 -d | openssl enc -aes-256-cbc -d -pbkdf2 -salt -pass "pass:$(pass show phrase/openssl)" | brotli -d
        ;;
	:run)
		data=$2
		shift 2
		eval "$(cat "$data" | tail -n +2 | base64 -d | brotli -d)"
		;;
    :*)
        echo "Invalid method!"
        echo "Try 'jkl --help' for more information"
        exit 1
        ;;
    *)
        curl -# "$HOSTURL$1"
        ;;
esac

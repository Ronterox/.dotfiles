#!/usr/bin/env bash
# @describe Framework extension for bashrc and my start file system
# @version 1.2
# @meta require-tools argc

install_missing() {
    declare -A PKG_INSTALL=([apt]="install" [dnf]="install" [yum]="install" [pacman]="-S" [apk]="add" [brew]="install")

    for pkg in "${!PKG_INSTALL[@]}"; do
        if hash "$pkg" 2>/dev/null; then
            PKG="$pkg"
            break
        fi
    done

    for req in "${@}"; do
        if [[ "$req" =~ ^([^:]+):([^:]+)$ ]]; then
            req="${BASH_REMATCH[1]}"
            pkg="${BASH_REMATCH[2]}"
        else
            pkg="$req"
        fi
        if ! hash "$req" 2>/dev/null; then
            echo "$pkg is not installed, proceeding to install it through $PKG"
            $PKG "${PKG_INSTALL[$PKG]}" "$pkg"
        fi
    done
}

install_missing git curl rg:ripgrep

set -e

main() {
    cat <<EOF
    start() {
        if [ \$# -eq 0 ]; then
            if [ -x start ]; then
                ./start
            else
                . start
            fi
        else
            if [ -x start ]; then
                start-tool "\$@" || ./start "\$@"
            else
                start-tool "\$@"
            fi
        fi
    }
EOF
}

GH_BASE_URL="https://api.github.com"

gh-lsf() {
    user=$1
    repo=$2
    branch=$3
    recursive=$4
    curl -s "$GH_BASE_URL/repos/$user/$repo/git/trees/$branch?recursive=${recursive:-0}" | jq -r '.tree[] | select(.type == "blob") | .path'
}

# @cmd List all asdf (runtime dependencies manager) plugins available.
asdf-plugins() { gh-lsf asdf-vm asdf-plugins master | rg ^plugins | cut -d'/' -f2; }

# @cmd Installs asdf if not installed.
asdf-install() {
    version="v0.18.0"
    repo="https://github.com/asdf-vm/asdf"
    if ! hash asdf 2>/dev/null; then
        echo "asdf is not installed, proceeding to install it."
        if [[ "$(uname -s)" == "Linux" ]]; then
            declare -A archs=([x86_64]="amd64" [arm64]="arm64" [aarch64]="arm64" [i686]="386" [i386]="386")
            target="asdf-$version-linux-${archs[$(arch)]}.tar.gz"
            wget "$repo/releases/download/$version/$target"
            tar xvzf "$target" && rm "$target"
        else
            install_missing go make
            if hash go 2>/dev/null; then
                git clone $repo.git --branch $version
                mv asdf /tmp && cd /tmp/asdf && make
            else
                echo "No method of automatic installation available for asdf on your system"
                echo "Please checkout $repo/releases"
                exit 1
            fi
        fi
        mv asdf /usr/local/bin && echo 'export PATH=$PATH:$HOME/.asdf/shims' >> ~/.bashrc
    fi
}

# @cmd List all dependencies of the start file.
# @alias deps,requirements
dependencies() {
    deps=$(rg '@meta\s*requirements\s*([^#]+)|@meta\s*require-tools\s*([^#]+)' -o -r '$1$2' "start" | tr ',' '\n' | sort | uniq)
    if [ -z "$deps" ]; then
        echo "No dependencies found."
        return
    fi

    echo "Dependencies:"
    for dep in $deps; do
        echo "- $dep"
    done
}

# @cmd Installs all the start file runtime dependencies through asdf.
# @alias i
install() {
    deps=$(rg '@meta\s*requirements\s*([^#]+)' -o -r '$1' "start" | tr ',' '\n' | sort | uniq)
    if [ -z "$deps" ]; then
        echo "No dependencies found."
        return
    fi

    asdf-install

    for dep in $deps; do
        if hash "$dep" 2>/dev/null; then
            echo "$dep already installed."
        else
            echo "Installing $dep..."
            if asdf plugin add "$dep"; then
                asdf install "$dep" || asdf install "$dep" latest
                echo "$dep $(asdf latest "$dep")" >> ~/.tool-versions
            else
                results=$(asdf-plugins | fzf --filter "$dep" | tr '\n' ',')
                echo "Did you mean any of these?" $results
            fi
        fi
    done
}

# @cmd Extends your shell with special functions
extend() {
    depts=(tmux-send-cmd z send)
    regex=""
    for dept in "${depts[@]}"; do
        patterns="^$dept\(\)\s*\{([^{}]|\{[^{}]*\})*\}|^alias $dept"
        if [ -n "$regex" ]; then
            regex="$regex|$patterns"
        else
            regex="$patterns"
        fi
    done
    rg -U "$regex" < ~/.bashrc
}

# @cmd Creates a new start file or upgrades an existing one
# @arg fn*
# @meta require-tools sed
create() {
    contents=""
    if [ -f start ]; then
        contents="$(cat start)"
        lines="---------------------------------------------"
        echo -e "##### $PWD/start #####\n$lines"
        echo "$contents"
        echo -ne "\n$lines\nThere is already a start file, do you want to upgrade it to a framework? [y/n]: "
        read -r confirm
        [[ "$confirm" =~ ^[nN][oO]? ]] && return
    fi

    cd /tmp && [ -f Argcfile.sh ] && rm Argcfile.sh
    argc --argc-create main "${argc_fn[@]}" > /dev/null
    if [ -n "$contents" ]; then
        sed "s/^/    /g" <(echo "$contents") > /tmp/contents
        sed -i -e '/echo TODO main/{r /tmp/contents' -e 'd}' Argcfile.sh
    fi
    sed -i '$i eval "$(start-tool extend)"' Argcfile.sh

    cd - && mv /tmp/Argcfile.sh start && chmod +x start
    echo "start file created!"
}

if ! hash argc 2>/dev/null; then
    echo "argc is not installed, proceeding to look for asdf installation method"
    asdf-install && asdf plugin add argc && asdf install argc latest && echo "argc $(asdf latest argc)" >> ~/.tool-versions
    echo "Restart your shell to apply the changes."
    exit 0
fi

# See more details at https://github.com/sigoden/argc
eval "$(argc --argc-eval "$0" "$@")"

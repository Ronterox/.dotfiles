#!/bin/env bash

metadata="Sended from $(hostname) $(cat /etc/issue) at $(date)"
message='<h1>You got mail!</h1><p>This is a <b>HTML</b> message.</p>'
sender='mikoprogramming@gmail.com'
subject="$metadata"
target=''
pass=$(pass show email/mikopass) # https://myaccount.google.com/apppasswords

for argv in "$@"; do
    case $argv in
        --app-pass=*) pass="${argv#*=}" ;;
        --message=*) message="${argv#*=}" ;;
        --sender=*) sender="${argv#*=}" ;;
        --target=*) target="${argv#*=}" ;;
        --subject=*) subject="${argv#*=}" ;;
        -h|--help)
            echo "Usage: $0 [--help] [--target=[self or example@email.com]] [--sender=] [--app-pass=] [--message=] [--subject=]"
            echo "Send an email with Gmail (supports HTML)"
            echo
            echo "Options:"
            echo "  -h, --help    Display this help and exit"
            echo "  --target      The target email address (can be 'self' for the sender email)"
            echo "  --sender      The sender email address"
            echo "  --app-pass    The app password for the sender email"
            echo "  --message     The HTML message to send"
            echo "  --subject     The subject of the email"
            exit 0
            ;;
        *)
            echo "Unknown option: $argv"
            echo "Try '$0 --help' for more information"
            exit 1
            ;;
    esac
done

if [ -z "$target" ]; then
    echo "No target specified"
    exit 1
fi

[ "$target" == 'self' ] && target=$sender
[[ "$message" =~ \.txt$ ]] && message=$(cat "$message")

txt=$(mktemp)
# Build HTML email headers
{
    echo "From: $sender"
    echo "To: $target"
    echo "Subject: $subject"
    echo "MIME-Version: 1.0"
    echo "Content-Type: text/html; charset=UTF-8"
    echo
    echo "$message"
    echo
    echo "<hr>"
    echo "<p style='font-size: 12px; color: #666;'><em>$metadata</em></p><hr>"
    echo "<hr>"
} > "$txt"

echo -e "Sending HTML email from $sender to $target..."
curl --silent --url 'smtps://smtp.gmail.com:465' --ssl-reqd \
  --mail-from "$sender" --mail-rcpt "$target" \
  --upload-file "$txt" --user "$sender:$pass"

rm "$txt"
echo "Done!"

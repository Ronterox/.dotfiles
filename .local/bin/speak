#!/usr/bin/env bash
# speak — say text with the piper voice used by the opencode notification hook
# (en_US amy, played 24 kHz at 1.25x tempo), or save it to a file.
#
#   speak "Hello there"            play it
#   echo "Hello" | speak           text from stdin
#   speak -o reply.wav "Hello"     write a file (.wav, .mp3, .ogg/.opus)
#
# OpenClaw uses this as its local TTS command (messages.tts tts-local-cli).

set -uo pipefail

VOICE="${SPEAK_VOICE:-$HOME/.opencode/plugins/en_US-amy-medium.onnx}"
OUT=""

die() { echo "speak: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case "$1" in
        -o) OUT=${2:?-o needs a file}; shift ;;
        -h | --help) sed -n '2,9s/^# \{0,1\}//p' "$0"; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
    shift
done

if [ $# -gt 0 ]; then TEXT="$*"; else TEXT=$(cat); fi

# Make markdown read well: drop code blocks, links' targets and formatting marks.
TEXT=$(printf '%s\n' "$TEXT" |
    sed -E '/^```/,/^```/d' |
    sed -E 's/!?\[([^]]*)\]\([^)]*\)/\1/g; s#https?://[^[:space:])]+#a link#g; s/`//g; s/[*_#>|]+/ /g; s/^[[:space:]]*[-•][[:space:]]+//' |
    tr '\n' ' ' | tr -s ' ')
[ -n "${TEXT// /}" ] || die "nothing to say"

[ -f "$VOICE" ] || die "voice not found: $VOICE (set SPEAK_VOICE)"
command -v piper >/dev/null || die "piper not found"
command -v ffmpeg >/dev/null || die "ffmpeg not found"

# Same sound as the hook: raw 22.05 kHz audio read as 24 kHz, sped up 1.25x.
synth() { printf '%s\n' "$TEXT" | piper -m "$VOICE" --output-raw 2>/dev/null; }

if [ -z "$OUT" ]; then
    synth | ffplay -af atempo=1.25 -v error -nodisp -autoexit -f s16le -ar 24000 -i pipe:0
    exit
fi

case "${OUT,,}" in
    *.mp3) fmt=(-c:a libmp3lame -b:a 96k -f mp3) ;;
    *.ogg | *.opus) fmt=(-c:a libopus -b:a 48k -ar 48000 -f ogg) ;;
    *) fmt=(-c:a pcm_s16le -f wav) ;;
esac
synth | ffmpeg -loglevel error -y -f s16le -ar 24000 -ac 1 -i pipe:0 -af atempo=1.25 "${fmt[@]}" "$OUT" ||
    die "ffmpeg failed writing $OUT"
[ -s "$OUT" ] || die "no audio produced"

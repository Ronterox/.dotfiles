#!/bin/bash

REPOSITORY="/media/rontero/LinuxBackup/Backup/"
LOGFILE="$HOME/.dotfiles/.local/share/backup.log"

export BORG_PASSCOMMAND="sudo -u $USER pass show env/borg"

case "$1" in
    --run)
        echo "Starting backup... Calculating ETA..."
        durations=()
        for a in $(sudo -E borg list --short "$REPOSITORY"); do
            taken=$(sudo -E borg info --json "$REPOSITORY::$a" | jq '.archives | .[0] | .duration')
            durations+=("$taken")
            echo "$a took $taken seconds"
        done

        total="0.0"
        for i in "${durations[@]}"; do
            total=$(echo "$total + $i" | bc)
        done

        if [ "$total" = "0.0" ]; then
            echo "No previous backups. Cannot calculate ETA."
        else
            total=$(echo "$total / ${#durations[@]}" | bc)
            echo "Expected Time: $(date -u -d @$total +%T)"
        fi

		read -rn1 -p "Press any key to run backup... "

        borgdaily "$REPOSITORY" && \
        bw list items --session "$(pass show env/bitwarden)" | pass insert -m -f bitwarden/backup

        if [ $? -eq 0 ]; then
            echo "Backup successful!"
            notify-send "Backup successful!"
            date >> "$LOGFILE"
        else
            echo "Backup failed!"
            notify-send "Backup failed!"
        fi
        ;;
    --show)
        if [ -f "$LOGFILE" ]; then
            # If file older than 2 days show in red
            if [ $(find "$LOGFILE" -mmin +1440) ]; then
                color=31
            else
                color=32
            fi
            echo -e "\e[${color}mLast backup: $(stat -c %y "$LOGFILE")\e[0m\n"
        else
            echo -e "\e[31mLast backup: Never\e[0m\n"
        fi
        ;;
    -h|--help)
        echo "Usage: backup [--show|run|help]"
        echo "Backup your files to your external hard drive or cloud storage"
        echo
        echo "Options:"
        echo "  --show    Show the backup status"
        echo "  --run     Run the backup command"
        echo "  --help    Display this help and exit"
        ;;
    *)
        echo "Unknown option: $1"
        echo "Try 'backup --help' for more information"
        exit 1
        ;;
esac
